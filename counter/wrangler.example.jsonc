{
  "name": "wentaochen-views",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {
    "ALLOWED_ORIGINS": "https://wentaochen.cn,https://www.wentaochen.cn"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "wentaochen-views",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
